{
  "name": "translation-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "check": "tsc --noEmit",
    "check:all": "node scripts/check-all.mjs",
    "check:api": "node scripts/api-smoke.mjs",
    "check:online-ui": "node scripts/online-ui-smoke.mjs",
    "check:sw": "node scripts/sw-cache-check.mjs",
    "benchmark:stream": "node scripts/stream-benchmark.mjs",
    "dict:download": "node scripts/download-dictionaries.mjs && node scripts/download-frequency-lists.mjs",
    "dict:clean": "node scripts/clean-dictionaries.mjs && node scripts/prepare-frequency-batch.mjs",
    "dict:test:ollama": "node scripts/ollama-schema-test.mjs --terms-file data/processed/generation_batch_frequency_400.txt --limit 12 --word-only",
    "dict:validate": "node scripts/validate-generated-dictionary.mjs output/ollama-dictionary-test.jsonl",
    "dict:import": "node scripts/import-generated-dictionary.mjs",
    "dict:query": "node scripts/query-dictionary.mjs",
    "dict:audit": "node scripts/audit-dictionary-quality.mjs",
    "dict:audit:senses": "node scripts/audit-dictionary-senses.mjs",
    "dict:batch": "node scripts/run-dictionary-batch.mjs",
    "dict:v2:init": "node scripts/init-dictionary-v2.mjs",
    "dict:v2:import:sources": "node scripts/import-dictionary-sources-v2.mjs",
    "dict:v2:build:canonical": "node scripts/build-dictionary-v2-canonical.mjs",
    "dict:v2:build:product-pilot": "node scripts/build-dictionary-v2-product-pilot.mjs",
    "dict:v2:review:product-fusion": "node scripts/review-dictionary-v2-product-fusion.mjs",
    "dict:v2:apply:product-fusion-reviews": "node scripts/apply-dictionary-v2-product-fusion-reviews.mjs",
    "dict:v2:apply:product-split-plans": "node scripts/apply-dictionary-v2-product-split-plans.mjs",
    "dict:v2:flag:product-source-mismatches": "node scripts/flag-dictionary-v2-product-source-mismatches.mjs",
    "dict:v2:relocate:product-source-mismatches": "node scripts/relocate-dictionary-v2-product-source-mismatches.mjs",
    "dict:v2:split:product-multi-source-mismatches": "node scripts/split-dictionary-v2-product-multi-source-mismatches.mjs",
    "dict:v2:clean:product-examples": "node scripts/clean-dictionary-v2-product-examples.mjs",
    "dict:v2:merge:product-entries": "node scripts/merge-dictionary-v2-product-entries.mjs",
    "dict:v2:merge:product-senses": "node scripts/merge-dictionary-v2-product-senses.mjs",
    "dict:v2:report:product-duplicate-senses": "node scripts/report-dictionary-v2-product-duplicate-senses.mjs",
    "dict:v2:report:product-candidate": "node scripts/report-dictionary-v2-product-candidate.mjs",
    "dict:v2:create:product-llm-jobs": "node scripts/create-dictionary-v2-product-llm-jobs.mjs",
    "dict:v2:create:product-quality-repair-jobs": "node scripts/create-dictionary-v2-product-quality-repair-jobs.mjs",
    "dict:v2:run:product-llm-jobs": "node scripts/run-dictionary-v2-product-llm-jobs.mjs",
    "dict:v2:promote:product-complete-senses": "node scripts/promote-dictionary-v2-product-complete-senses.mjs",
    "dict:v2:complete:product-audit-samples": "node scripts/complete-dictionary-v2-product-audit-samples.mjs",
    "dict:v2:repair:product-needs-review-localizations": "node scripts/repair-dictionary-v2-product-needs-review-localizations.mjs",
    "dict:v2:supplement:product-polyphones": "node scripts/supplement-dictionary-v2-product-polyphones.mjs",
    "dict:v2:repair:product-known-localizations": "node scripts/repair-dictionary-v2-product-known-localizations.mjs",
    "dict:v2:repair:product-known-duplicate-senses": "node scripts/repair-dictionary-v2-product-known-duplicate-senses.mjs",
    "dict:v2:repair:product-quality-warnings": "node scripts/repair-dictionary-v2-product-quality-warnings.mjs",
    "dict:v2:merge:senses": "node scripts/merge-dictionary-v2-senses.mjs",
    "dict:v2:create-llm-jobs": "node scripts/create-dictionary-v2-llm-jobs.mjs",
    "dict:v2:benchmark:ollama": "node scripts/benchmark-dictionary-v2-ollama.mjs",
    "dict:v2:run-llm-jobs": "node scripts/run-dictionary-v2-llm-jobs.mjs",
    "dict:v2:audit": "node scripts/audit-dictionary-v2-quality.mjs",
    "dict:v2:audit:product-export": "node scripts/audit-dictionary-v2-product-export.mjs",
    "dict:v2:query": "node scripts/query-dictionary-v2.mjs",
    "dict:v2:progress": "node scripts/inspect-dictionary-v2-progress.mjs data/processed/linguago_v2_full.db",
    "dict:v2:rank:frequency": "node scripts/rank-dictionary-v2-frequency.mjs",
    "dict:v2:apply-overrides": "node scripts/apply-dictionary-v2-overrides.mjs",
    "dict:v2:export:d1-native": "node scripts/export-dictionary-v2-native-d1-sql.mjs --db data/processed/linguago_v2_full.db --out-dir outputs/d1-v2-native-export",
    "dict:v2:export:product-d1-native": "node scripts/export-dictionary-v2-product-native-d1-sql.mjs --db data/processed/linguago_v2_product_top5000_fused_only_pilot.db --out-dir outputs/d1-v2-product-native-export",
    "dict:v2:release:product-d1": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/release-dictionary-v2-product-d1.ps1",
    "dict:v2:push:d1-native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/push-dictionary-v2-native-to-d1.ps1 -DbPath data/processed/linguago_v2_full.db -OutDir outputs/d1-v2-native-export",
    "dict:test:deepseek": "node scripts/deepseek-dictionary-test.mjs --candidates-file data/processed/generation_batch_frequency_400.jsonl --limit 12 --word-only",
    "check:theme": "node scripts/system-theme-check.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260606.1",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "playwright": "^1.60.0",
    "sql.js": "^1.14.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wrangler": "^4.98.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "csv-parser": "^3.2.1",
    "fast-xml-parser": "^5.8.0",
    "lucide-vue-next": "^1.0.0",
    "pinyin-pro": "^3.28.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.35",
    "vuetify": "^4.1.0"
  }
}
