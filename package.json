{
  "name": "translation-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "check": "tsc --noEmit",
    "check:all": "node scripts/check-all.mjs",
    "check:api": "node scripts/api-smoke.mjs",
    "check:sw": "node scripts/sw-cache-check.mjs",
    "benchmark:stream": "node scripts/stream-benchmark.mjs",
    "dict:download": "node scripts/download-dictionaries.mjs && node scripts/download-frequency-lists.mjs",
    "dict:clean": "node scripts/clean-dictionaries.mjs && node scripts/prepare-frequency-batch.mjs",
    "dict:test:ollama": "node scripts/ollama-schema-test.mjs --terms-file data/processed/generation_batch_frequency_400.txt --limit 12 --word-only",
    "dict:validate": "node scripts/validate-generated-dictionary.mjs output/ollama-dictionary-test.jsonl",
    "dict:import": "node scripts/import-generated-dictionary.mjs",
    "dict:query": "node scripts/query-dictionary.mjs",
    "dict:audit": "node scripts/audit-dictionary-quality.mjs",
    "dict:audit:senses": "node scripts/audit-dictionary-senses.mjs",
    "dict:batch": "node scripts/run-dictionary-batch.mjs",
    "dict:test:deepseek": "node scripts/deepseek-dictionary-test.mjs --candidates-file data/processed/generation_batch_frequency_400.jsonl --limit 12 --word-only",
    "check:theme": "node scripts/system-theme-check.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260606.1",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "playwright": "^1.60.0",
    "sql.js": "^1.14.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wrangler": "^4.98.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "csv-parser": "^3.2.1",
    "fast-xml-parser": "^5.8.0",
    "lucide-vue-next": "^1.0.0",
    "pinyin-pro": "^3.28.1",
    "vue": "^3.5.35"
  }
}
