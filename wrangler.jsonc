{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "translation-pwa",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "dd1cac03419b418dab1300a6bd318e08"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "linguago-dictionary",
      "database_id": "ee613260-5c1f-4bb5-8959-c54118174e0e"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
